# AB Logistics OS - Minimal production env template
# Copy to `.env` and fill with real values.
# Never commit real secrets.

# -------------------------------------------------------------------
# Deployment bootstrap (used by scripts/deploy-prod.sh)
# -------------------------------------------------------------------
DOMAIN=app.example.com
ADMIN_EMAIL=ops@example.com

# -------------------------------------------------------------------
# Runtime / network
# -------------------------------------------------------------------
ENVIRONMENT=production
CORS_ALLOW_ORIGINS=https://app.example.com
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_API_BASE=/api
INTERNAL_API_BASE_URL=http://backend:8000

# -------------------------------------------------------------------
# Backend critical secrets
# -------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=
JWT_SECRET_KEY=
ENCRYPTION_KEY=

# -------------------------------------------------------------------
# Redis / queue
# -------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
ARQ_BILLING_QUEUE_NAME=arq:queue

# -------------------------------------------------------------------
# AEAT certificates (mounted read-only in backend)
# -------------------------------------------------------------------
AEAT_CERTS_HOST_DIR=./backend/certs
AEAT_P12_PATH=/run/secrets/aeat-certs/certificate.p12
AEAT_CERT_PASSPHRASE=

# -------------------------------------------------------------------
# Optional observability
# -------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# -------------------------------------------------------------------
# Contact / security metadata
# -------------------------------------------------------------------
SECURITY_CONTACT_EMAIL=security@example.com
